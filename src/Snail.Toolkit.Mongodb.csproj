<Project Sdk="Snail.Sdk.Library">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <!-- Measured with a probe published with Native AOT: the driver itself warns and then fails. -->
        <SnailNotNativeBecause>MongoDB.Driver and MongoDB.Bson 3.10 are not trim- or AOT-safe: a native publish warns IL2104 and IL3053 for both, and the BSON class maps fail at run time (MissingMethodException building a serializer).</SnailNotNativeBecause>
        <PackageId>Snail.Toolkit.Mongodb</PackageId>
        <PackageTags>MongoDB, GridFS</PackageTags>
        <Title>Snail.Toolkit.Mongodb</Title>
        <Authors>Toolkit</Authors>
        <Description>Extension for the framework MongoDB.Driver</Description>
        <RepositoryUrl>https://github.com/orldev/Snail.Toolkit.Mongodb</RepositoryUrl>
        <Copyright>Toolkit, 2023</Copyright>
        <PackageProjectUrl>https://github.com/orldev/Snail.Toolkit.Mongodb</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
        <PackageReference Include="Microsoft.Extensions.Configuration" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
        <PackageReference Include="MongoDB.Driver" />
    </ItemGroup>
</Project>
