root = true

[*.cs]
indent_style = space
indent_size = 4
insert_final_newline = true
charset = utf-8

# A comparison that does not state its intent is a bug waiting for a different locale.
dotnet_diagnostic.CA1305.severity = warning
dotnet_diagnostic.CA1307.severity = warning
dotnet_diagnostic.CA1310.severity = warning

[tests/**.cs]
# Tests are named Subject_Condition_ExpectedResult, which is the point of the underscores.
dotnet_diagnostic.CA1707.severity = none
