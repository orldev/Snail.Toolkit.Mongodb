<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net7.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PackageTags>MongoDB, GridFS</PackageTags>
        <Title>Toolkit.Mongo</Title>
        <Authors>Toolkit</Authors>
        <Description>Extension for the framework MongoDB.Driver</Description>
        <RepositoryUrl>https://github.com/orldev/Toolkit.Mongo</RepositoryUrl>
        <Copyright>Toolkit, 2023</Copyright>
        <PackageProjectUrl>https://github.com/orldev/Toolkit.Mongo</PackageProjectUrl>
        <RepositoryType>GitHub</RepositoryType>
    </PropertyGroup>
    
    
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="7.0.4" />
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="7.0.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="7.0.0" />
        <PackageReference Include="MongoDB.Driver" Version="2.22.0" />
        <PackageReference Include="MongoDB.Driver.GridFS" Version="2.22.0" />
    </ItemGroup>
</Project>
